# Copia este archivo a frontend/.env y ajusta los valores.


#
# Host del backend. Dos formas:
#  - URL completa con esquema: https://api.ecoreto.app  (opcional puerto aqui o en BACKEND_PORT)
#  - Solo host/IP de LAN:     192.168.1.50  (requiere BACKEND_PORT)
# BACKEND_HOST es UN solo valor (el principal). Los respaldos para failover
# van en BACKENDS, coma-separados.
BACKEND_HOST=http://localhost:3000
# Prefijo global de rutas del backend
# VACIO cuando los hosts ya traen URL completa (tuneles): si lo llenas se
# anexa ':3000' al tunel y lo rompe. Solo se usa con host/IP sin esquema.
BACKEND_PORT=
# Respaldos para failover automatico, en orden (opcional).
# Si el principal no responde al arrancar, la app prueba cada uno en orden;
# los GET tambien reintentan en el siguiente ante fallo de red o error 5xx.
# Ejemplos (ajusta IDs/puertos, no uses estos tal cual):
#BACKENDS=https://xxxx-3000.use.devtunnels.ms
#BACKENDS=https://api-respaldo.ecoreto.app,192.168.1.51:3000
BACKENDS=https://9glgn57m-3000.use.devtunnels.ms
# Prefijo global de rutas del backend (debe coincidir con setGlobalPrefix del backend)
API_PREFIX=gg
UPLOADS_PREFIX=uploads
