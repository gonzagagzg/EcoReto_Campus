# Copia este archivo a backend/.env y ajusta los valores.

# Servidor
PORT=3000

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=ecoretobd
DB_SYNCHRONIZE=false
DB_LOGGING=true

# JWT. Genera secretos propios, p.ej.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=changeme-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=changeme-por-otro-secreto-largo-y-aleatorio
JWT_REFRESH_EXPIRES_IN=7d

# Almacenamiento local de archivos
UPLOADS_DIR=uploads

# Asistente IA local (Ollama). Apagado por defecto: pon true para activarlo.
# Requiere el servidor de Ollama corriendo y el modelo descargado.
IA_ENABLED=false
IA_MODEL= poner modelo
OLLAMA_HOST=http://localhost:11434
# Timeout para la respuesta de Ollama (ms). La primera carga del modelo puede tardar 60-120s.
OLLAMA_TIMEOUT_MS=220000
# Credenciales de Ollama (opcionales: un Ollama local no las necesita).
# Nube de Ollama o proxy con clave (se envia como Bearer):
#OLLAMA_API_KEY=tu-clave-aqui
# Proxy con autenticacion basica (usuario + contrasena):
#OLLAMA_BASIC_USER=usuario
#OLLAMA_BASIC_PASSWORD=contrasena

# Dominios aceptados en el correo institucional (vacio = sin restriccion)
CORREO_DOMINIOS_INSTITUCIONALES=ecoreto.campus

# Origenes permitidos por CORS (separados por coma, sin barra final).
# App empaquetada Capacitor: Android usa https://localhost (o http://localhost
# en Capacitor viejos) e iOS usa capacitor://localhost. Web en desarrollo:
# http://localhost:4200 (Angular), :8100 (Ionic) y el tunel de la web si se usa
# (ej: https://xxxx-4200.use.devtunnels.ms).
# Para aceptar cualquier origen en dev se puede usar "*".
# En produccion: SOLO lista explicita con tu dominio web + los origenes de la app.
CORS_ORIGINS=http://localhost:4200,http://localhost:8100,capacitor://localhost,https://localhost,http://localhost,ionic://localhost
# Ejemplo con tunel de desarrollo (descomenta y ajusta el ID cuando lo uses):
#CORS_ORIGINS=http://localhost:4200,https://xxxx-4200.use.devtunnels.ms,capacitor://localhost,https://localhost,http://localhost,ionic://localhost
